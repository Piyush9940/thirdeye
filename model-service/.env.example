# ==============================================================================
# Earth Systems Trend Detective — ML Inference Service Environment Configuration
# ==============================================================================

# Server settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PyTorch Inference Device (cpu / cuda)
INFERENCE_DEVICE=cpu

# Model package directory (defaults to ./models/production_reference)
MODEL_PACKAGE_DIR=./models/production_reference

# Optional service-to-service security key (X-API-Key header)
# Leave empty for open internal service access
MODEL_SERVICE_API_KEY=
