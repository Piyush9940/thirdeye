# ==========================================================
# EARTH SYSTEMS TREND DETECTIVE
# ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================

# ---------------- PROJECT SETTINGS ----------------
PROJECT_NAME=Earth Systems Trend Detective
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# ---------------- DATA STORAGE ----------------
DATA_ROOT=./data

# ---------------- DATABASE ----------------
# MongoDB connection URL (with automatic local JSON fallback)
MONGODB_URI=mongodb://localhost:27017/earth_trend_detective
JWT_SECRET=nasa_space_apps_earth_trend_detective_secret_key_2026
JWT_EXPIRES_IN=7d

# ---------------- PYTHON RUNTIME ----------------
PYTHON_PATH=python

# ---------------- NASA EARTHDATA ----------------
# Register at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Compatibility aliases for Harmony client
EDL_USERNAME=your_earthdata_username
EDL_PASSWORD=your_earthdata_password

# ---------------- NASA HARMONY API ----------------
HARMONY_FORMAT=application/x-netcdf
HARMONY_CHECK_INTERVAL=5
HARMONY_DOWNLOAD_TIMEOUT=3600

# ---------------- NASA CMR (Common Metadata Repository) ----------------
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov
NASA_CMR_PAGE_SIZE=100
NASA_CMR_TIMEOUT=120

# ---------------- COPERNICUS DATASPACE (Sentinel-5P) ----------------
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_USERNAME=your_copernicus_email
COPERNICUS_PASSWORD=your_copernicus_password
COPERNICUS_BASE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
COPERNICUS_TIMEOUT=180

# ---------------- NOAA ERDDAP ----------------
NOAA_ERDDAP_BASE_URL=https://www.ncei.noaa.gov/erddap
NOAA_REQUEST_TIMEOUT=180
NOAA_MAX_RETRIES=3
NOAA_PAGE_SIZE=1000

# ---------------- NOAA CDO (Climate Data Online) ----------------
# Request token from: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=your_noaa_cdo_token_here

# ---------------- DOWNLOAD & PROCESSING ----------------
DOWNLOAD_CHUNK_SIZE=1048576
DOWNLOAD_MAX_RETRIES=3
OVERWRITE_DOWNLOADS=false

TIME_START=2015-01-01
TIME_END=2024-12-31

# India Subcontinent Bounding Box: west, south, east, north
BBOX_WEST=68.0
BBOX_SOUTH=6.0
BBOX_EAST=98.0
BBOX_NORTH=39.0

# ---------------- OPTIONAL AI ASSISTANT PROVIDERS ----------------
# Built-in grounded scientific offline engine requires zero API keys.
# External keys can be provided for LLM augmentation:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------------- OPTIONAL CLOUDINARY MEDIA ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
